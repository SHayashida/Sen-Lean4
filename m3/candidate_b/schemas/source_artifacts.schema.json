{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "package_path": {"type": "string"},
          "source_blob_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
          "source_path": {"type": "string"}
        },
        "required": ["source_path", "source_blob_sha", "content_sha256", "package_path"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence_root": {"const": "m3/candidate_b/evidence"},
    "schema_version": {"const": "m3-candidate-b-source-artifacts-v1"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "whitelist_policy": {"const": "exact-paths-only"}
  },
  "required": ["schema_version", "source_commit", "evidence_root", "whitelist_policy", "entries"],
  "type": "object"
}
